{
  "name": "@dsh-external/dsh-harness-pilot",
  "version": "0.2.0",
  "description": "把 DeepSeek 宿主原生调不了的外部 harness（claude / codex / pi / MiMo）接入 DSH：作为子代理派发任务，可指定各家模型，并在设置页里查看已配置的 harness",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "assets",
    "lib",
    "client",
    "python",
    "scripts",
    "vendor",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <6",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc <3",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <3",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "plugin": {
      "runtime": {
        "python": ">=3.9 (pyautogui + Pillow + pywin32 + uiautomation) — 仅窗口级操控需要"
      }
    }
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
